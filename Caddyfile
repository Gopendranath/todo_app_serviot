# Caddyfile for todo-app-serviot

todo-serviot.64kbits.com {
    # Set the root directory for the frontend
    root * /home/ubuntu/todo_app_serviot/frontend/dist

    # Serve static files
    file_server

    # Handle SPA routing (fallback to index.html for unknown routes)
    try_files {path} /index.html

    # Proxy API requests to the backend
    reverse_proxy /api/* localhost:4000

    # Enable gzip compression
    encode gzip zstd

    # Logging
    log {
        output file /var/log/caddy/todo.log
    }
}
